<?xml version="1.0" encoding="utf-8"?>
<!-- 下一班公車: stacked rows only (vertical LinearLayout), so lines never overlap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/bus_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="#17140f" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" android:text="下一班公車" />
        <TextView android:id="@+id/bus_edit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="11sp" android:textColor="#7a7062" android:text="換站" />
    </LinearLayout>
    <TextView android:id="@+id/bus_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="11.5sp" android:textColor="#4a4339" android:maxLines="1" android:ellipsize="end" android:text="點「換站」選路線與站牌" />
    <TextView android:id="@+id/bus_l1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="22sp" android:textStyle="bold" android:textColor="#b42a1a" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" android:text="–" />
    <TextView android:id="@+id/bus_l2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12.5sp" android:textColor="#4a4339" android:maxLines="2" android:ellipsize="end" android:text="" />
    <TextView android:id="@+id/bus_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="10sp" android:textColor="#7a7062" android:fontFamily="monospace" android:maxLines="1" android:text="點一下更新" />
</LinearLayout>
